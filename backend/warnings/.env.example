# Copy to .env and fill in. Leave Twilio values blank to run in dry-run mode
# (the SMS copy is built and returned, but nothing is sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

SITE_URL=https://wehatescammers.com

# Tier behavior
SEND_LOW_TIER=false
HIGH_REPEAT_COUNT=3
