# Copy to .env and fill in. Leave TEXTBELT_KEY blank to run in dry-run mode
# (the SMS copy is built and returned, but nothing is sent).
# Use `textbelt` for the free quota (1 SMS/day). A paid key sends without that cap.
TEXTBELT_KEY=

SITE_URL=https://wehatescammers.com

# Tier behavior
SEND_LOW_TIER=false
HIGH_REPEAT_COUNT=3
