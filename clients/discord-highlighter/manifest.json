{
  "manifest_version": 3,
  "name": "Discord Scam Smell",
  "version": "1.1.0",
  "description": "Offline highlighter for suspicious Discord messages. Caution is yellow, high risk is red.",
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "css": ["content.css"],
      "js": ["scorer.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
